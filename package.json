{
  "name": "scenaria",
  "version": "0.9.24",
  "description": "Quicksave & checkpoints for AI agents \u2014 any LLM, any framework. A decision tree you can rewind, fork and verify via MCP, HTTP, CLI, function calling and a visual scenario map.",
  "type": "module",
  "bin": {
    "scenaria": "dist/cli.js"
  },
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "files": [
    "dist",
    "templates",
    "clients",
    "examples",
    "install.sh",
    "install.ps1",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/GUIDE.md",
    "docs/GUIDE.de.md",
    "docs/KNOWN-LIMITS.md",
    "docs/screenshot.png",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm test",
    "build:binaries": "node scripts/build-binaries.mjs",
    "typecheck:ui": "tsc -p tsconfig.uicheck.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "checkpoint",
    "rewind",
    "decision-tree",
    "claude-code",
    "openai",
    "gemini",
    "ollama",
    "function-calling",
    "llm",
    "ai-governance",
    "agent-observability",
    "context-engineering"
  ],
  "author": "Kevin Grundmann <kevin.grundmann@ai-gambit.com> (AI-Gambit)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
