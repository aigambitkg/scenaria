{
  "name": "scenaria",
  "version": "0.9.24",
  "description": "Approval and evidence for the work of AI agents: every step recorded, only the person approves (signed), an audit file ordered by ISO/IEC 42001 Annex A, and a way back to every earlier state. Any LLM, local first; MCP, HTTP, CLI and a dashboard.",
  "type": "module",
  "bin": {
    "scenaria": "dist/cli.js"
  },
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "files": [
    "dist",
    "templates",
    "clients",
    "examples",
    "install.sh",
    "install.ps1",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/GUIDE.md",
    "docs/GUIDE.de.md",
    "docs/KNOWN-LIMITS.md",
    "docs/screenshot.png",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm test",
    "build:binaries": "node scripts/build-binaries.mjs",
    "typecheck:ui": "tsc -p tsconfig.uicheck.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "checkpoint",
    "rewind",
    "decision-tree",
    "claude-code",
    "openai",
    "gemini",
    "ollama",
    "function-calling",
    "llm",
    "ai-governance",
    "approval",
    "audit-trail",
    "iso-42001",
    "agent-observability",
    "context-engineering"
  ],
  "author": "Kevin Grundmann <kevin.grundmann@ai-gambit.com> (AI-Gambit)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
