# --- internal notes and transfer files (not for the public repository)
docs/intern/
.xfer/
*.tar
*.tgz
*.pack
*.zip

# --- secrets: never commit keys or environment files
.env
.env.*
*.pem
*.key
*.p12
approver-key*
trusted-approvers.json

# --- noise
*.log
.DS_Store
Thumbs.db
